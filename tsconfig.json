{
  "compilerOptions": {
    "rootDirs": [
      "./src",
      "./sample"
    ],
    "outDir": "./dist",
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*",
    "./sample/**/*",
    "vite.config.ts"
  ]
}